<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: Arial, sans-serif; font-size: 12px; }
    h1 { font-size: 18px; margin-bottom: 10px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #ddd; padding: 6px; }
    th { background: #f2f2f2; text-align: left; }
  </style>
</head>
<body>
  <h1>Reporte de Reservas</h1>
  <table>
    <thead>
      <tr>
        <th>ID</th><th>Fecha</th><th>Cliente</th><th>Turno</th><th>Salon</th><th>Servicios</th><th>Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each reservas}}
        <tr>
          <td>{{this.reserva_id}}</td>
          <td>{{this.fecha_reserva}}</td>
          <td>{{this.cliente}}</td>
          <td>{{this.orden}}</td>
          <td>{{this.titulo}}</td>
          <td>{{this.servicios}}</td>
          <td>{{this.importe_total}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</body>
</html>